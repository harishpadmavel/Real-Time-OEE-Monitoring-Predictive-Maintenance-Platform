{
  "name": "real-time-oee-platform",
  "version": "1.0.0",
  "description": "Real-Time OEE Monitoring & Predictive Maintenance Platform (MERN + Socket.IO)",
  "scripts": {
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "install:backend": "cd 03-backend-code && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm run install:backend && npm run install:frontend",
    "seed": "cd 03-backend-code && npm run seed",
    "backend": "cd 03-backend-code && node server.js",
    "frontend": "cd frontend && npm run dev",
    "dev:backend": "cd 03-backend-code && npm start",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "socket.io": "^4.7.5"
  },
  "keywords": [
    "oee",
    "manufacturing",
    "predictive-maintenance",
    "mern",
    "socket.io",
    "react"
  ],
  "author": "",
  "license": "ISC"
}
